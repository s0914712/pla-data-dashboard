# Supabase Edge Function 環境變數 —— 只列名稱，不可填入真實值後 commit。
# 設定位置：Dashboard → Project Settings → Edge Functions → Secrets
# 或 CLI：supabase secrets set KEY=value
#
# 名稱大小寫敏感。程式（lib/env.ts）會先讀標準名稱，找不到再讀舊別名，
# 所以既有的 LINE_UserID / LINE_Channel_access_token 可以先留著不動。

# --- 必要 -------------------------------------------------------------------
# LINE Developers → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers → Messaging API → Channel access token（長期）
LINE_CHANNEL_ACCESS_TOKEN=
# Google 服務帳戶的完整 JSON 金鑰（單行貼上即可）
GOOGLE_SERVICE_ACCOUNT_JSON=
# 目標共用日曆 ID，形如 xxx@group.calendar.google.com
# 注意：不是服務帳戶的 email，也不是你的 Gmail
GOOGLE_CALENDAR_ID=
# 管理員的 LINE userId；/bind、/diag、/cleanup 只認這個人
ADMIN_LINE_USER_ID=

# --- 選配 -------------------------------------------------------------------
# 緊急停用開關。設 false 時仍驗簽並回 200，但不做任何寫入。預設 true。
BOT_ENABLED=true
# 待確認行程的有效時間（分鐘）。預設 15。
PENDING_TTL_MINUTES=15
# 預設 Asia/Taipei。
DEFAULT_TIMEZONE=Asia/Taipei
# 僅供識別，驗證仍以簽章為準。
LINE_CHANNEL_ID=

# --- 不要設定 ---------------------------------------------------------------
# SUPABASE_URL 與 SUPABASE_SERVICE_ROLE_KEY 由 Edge Runtime 自動注入，
# 且 SUPABASE_ 前綴是保留字，手動設定會被拒絕。
